# Copy this file to .env and fill in your values.

# Port the server listens on.
MCP_PORT=80

# Full public URL used in download links returned to the LLM.
# Must include http:// and the port.
# Local development:  http://localhost:80
# VM / remote host:   http://x.x.x.x:80   (replace with your VM's IP)
MCP_PUBLIC_URL=http://localhost:80
